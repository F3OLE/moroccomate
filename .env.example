# Public site URL (used for sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://moroccomate.com

# Social profiles (leave blank until ready — icons show as “coming soon”)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@yourhandle
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/yourpage
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@yourchannel
# NEXT_PUBLIC_SOCIAL_X=https://x.com/yourhandle
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/yourcompany

# Supabase. Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Optional. Only for server admin reads; never put this in the browser or chat
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini. Server only (never NEXT_PUBLIC_)
# Required for AI trip planning. Without it, Plan falls back to curated places.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp booking inbox (digits with country code, no +). Opens after a traveler books.
# Example Morocco: 2126XXXXXXXX
NEXT_PUBLIC_BOOKING_WHATSAPP=2126XXXXXXXX
